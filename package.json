{
  "name": "zellous-discord",
  "version": "1.0.0",
  "description": "Bidirectional Discord and zellous bridge with room sync and per-user voice reflection",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnEntrypoint/zellous-discord.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "unit": "node --import tsx --test test/unit/*.test.ts",
    "integration": "node --import tsx --test test/integration/*.test.ts",
    "check": "npm run typecheck && npm run unit",
    "secret:scan": "node scripts/secret-scan.mjs",
    "secret:red-check": "node scripts/secret-scan.mjs --self-test",
    "live:alignment": "node scripts/live-alignment.mjs",
    "alignment:red-check": "node scripts/live-alignment.mjs --self-test",
    "intent:guard": "node scripts/intent-guard.mjs",
    "intent:red-check": "node scripts/intent-guard.mjs --self-test",
    "serve:check": "node scripts/serve-health.mjs",
    "config:check": "node scripts/config-check.mjs",
    "witness:suite": "node scripts/witness-suite.mjs",
    "full:window": "node scripts/full-window.mjs",
    "live:reconcile": "node dist/cli.js reconcile",
    "live:inventory": "node dist/cli.js inventory",
    "live:voice": "node dist/cli.js voice-smoke",
    "restart:recovery": "node scripts/restart-recovery.mjs",
    "health": "node dist/cli.js health",
    "serve": "node dist/cli.js serve"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.28.1",
    "nostr-tools": "2.26.1",
    "opusscript": "0.0.8",
    "werift": "0.28.0",
    "wireweave": "github:AnEntrypoint/wireweave#5d451241587181e471e263f44db993ba8e2d5764",
    "ws": "8.23.0",
    "xstate": "5.33.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}