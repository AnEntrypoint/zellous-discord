{
  "name": "zellous-discord",
  "version": "1.0.0",
  "description": "Bidirectional Discord and zellous bridge with room sync and per-user voice reflection",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnEntrypoint/zellous-discord.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "unit": "node --import tsx --test test/unit/*.test.ts",
    "integration": "node --import tsx --test test/integration/*.test.ts",
    "check": "npm run typecheck && npm run unit",
    "secret:scan": "node scripts/secret-scan.mjs",
    "secret:red-check": "node scripts/secret-scan.mjs --self-test",
    "live:alignment": "node scripts/live-alignment.mjs",
    "alignment:red-check": "node scripts/live-alignment.mjs --self-test",
    "spec:alignment": "node scripts/spec-alignment.mjs",
    "spec:red-check": "node scripts/spec-alignment.mjs --self-test",
    "intent:guard": "node scripts/intent-guard.mjs",
    "intent:red-check": "node scripts/intent-guard.mjs --self-test",
    "discover:publish": "node dist/cli.js discover-publish",
    "discover:query": "node scripts/relay-query.mjs",
    "discover:red-check": "node scripts/discover-red-check.mjs",
    "source:truth": "node scripts/source-of-truth.mjs",
    "source:red-check": "node scripts/source-red-check.mjs",
    "presence:red-check": "node scripts/presence-red-check.mjs",
    "chat:post": "node dist/cli.js chat-post",
    "snapshot:reconcile": "node dist/cli.js snapshot-reconcile",
    "snapshot:rollback": "node dist/cli.js snapshot-rollback",
    "snapshot:red-check": "node scripts/snapshot-red-check.mjs",
    "cleanup": "node --import tsx src/cli.ts cleanup",
    "cleanup:rollback": "node --import tsx src/cli.ts cleanup-rollback",
    "cleanup:red-check": "node scripts/cleanup-red-check.mjs",
    "channel-root:red-check": "node scripts/channel-root-red-check.mjs",
    "ui:marker": "node scripts/ui-marker.mjs",
    "ui:marker-red-check": "node scripts/ui-marker-red-check.mjs",
    "text:marker": "node scripts/text-marker.mjs",
    "text:red-check": "node scripts/text-red-check.mjs",
    "voice:red-check": "node scripts/voice-red-check.mjs",
    "relay:heal": "node scripts/relay-heal.mjs",
    "voice:pool": "node scripts/voice-pool-check.mjs",
    "voice:bridge": "node scripts/voice-bridge-check.mjs",
    "voice:proof": "node scripts/voice-proof.mjs",
    "voice:proof-red-check": "node scripts/voice-proof-red-check.mjs",
    "final:window": "node scripts/final-window.mjs",
    "window:a": "node scripts/final-window.mjs --part=a",
    "window:b": "node scripts/final-window.mjs --part=b",
    "serve:check": "node scripts/serve-health.mjs",
    "config:check": "node scripts/config-check.mjs",
    "witness:suite": "node scripts/witness-suite.mjs",
    "full:window": "node scripts/full-window.mjs",
    "live:window": "node scripts/live-window.mjs",
    "live:reconcile": "node dist/cli.js reconcile",
    "live:inventory": "node dist/cli.js inventory",
    "live:voice": "node dist/cli.js voice-smoke",
    "live:restart": "node scripts/live-restart.mjs",
    "restart:recovery": "node scripts/restart-recovery.mjs",
    "health": "node dist/cli.js health",
    "serve": "node dist/cli.js serve"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "discord.js": "14.28.1",
    "nostr-tools": "2.26.1",
    "opusscript": "0.0.8",
    "werift": "0.28.0",
    "wireweave": "github:AnEntrypoint/wireweave#4b73168fbfbb2f13f11e56e368244166955f6af2",
    "ws": "8.23.0",
    "xstate": "5.33.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}